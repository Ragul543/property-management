<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Send WhatsApp Wizard Form View -->
    <record id="send_whatsapp_wizard_view_form" model="ir.ui.view">
        <field name="name">send.whatsapp.wizard.form</field>
        <field name="model">send.whatsapp.wizard</field>
        <field name="arch" type="xml">
            <form string="Send WhatsApp Message">
                <group>
                    <field name="partner_id" options="{'no_create': True}"/>
                    <field name="employee_id" options="{'no_create': True}"/>
                    <field name="phone"/>
                </group>
                <group>
                    <field name="message" placeholder="Type your message here..."/>
                </group>
                <group string="Attachments (Optional)">
                    <field name="attachment_ids" widget="many2many_binary"/>
                    <field name="media_caption" placeholder="Caption for media"
                           invisible="not attachment_ids"/>
                </group>
                <footer>
                    <button name="action_send" string="Send" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open wizard -->
    <record id="send_whatsapp_wizard_action" model="ir.actions.act_window">
        <field name="name">Send WhatsApp</field>
        <field name="res_model">send.whatsapp.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

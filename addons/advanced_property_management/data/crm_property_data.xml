<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Property Sales CRM Team -->
        <record id="crm_team_property_sales" model="crm.team">
            <field name="name">Property Sales Team</field>
            <field name="sequence">20</field>
        </record>

        <!-- CRM Stages for Property Pipeline -->
        <record id="stage_new_inquiry" model="crm.stage">
            <field name="name">New Inquiry</field>
            <field name="sequence">1</field>
            <field name="team_id" ref="crm_team_property_sales"/>
        </record>
        <record id="stage_contacted" model="crm.stage">
            <field name="name">Contacted</field>
            <field name="sequence">2</field>
            <field name="team_id" ref="crm_team_property_sales"/>
        </record>
        <record id="stage_property_matching" model="crm.stage">
            <field name="name">Property Matching</field>
            <field name="sequence">3</field>
            <field name="team_id" ref="crm_team_property_sales"/>
        </record>
        <record id="stage_viewing_scheduled" model="crm.stage">
            <field name="name">Viewing Scheduled</field>
            <field name="sequence">4</field>
            <field name="team_id" ref="crm_team_property_sales"/>
        </record>
        <record id="stage_negotiation" model="crm.stage">
            <field name="name">Negotiation</field>
            <field name="sequence">5</field>
            <field name="team_id" ref="crm_team_property_sales"/>
        </record>
        <record id="stage_won" model="crm.stage">
            <field name="name">Won (Deal Closed)</field>
            <field name="sequence">70</field>
            <field name="is_won">True</field>
            <field name="team_id" ref="crm_team_property_sales"/>
        </record>
    </data>
</odoo>

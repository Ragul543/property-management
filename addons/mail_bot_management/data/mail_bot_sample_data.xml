<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Sample Tags -->
        <record id="mail_bot_tag_work" model="mail.bot.tag">
            <field name="name">Work</field>
            <field name="sequence">1</field>
            <field name="color">1</field>
        </record>

        <record id="mail_bot_tag_personal" model="mail.bot.tag">
            <field name="name">Personal</field>
            <field name="sequence">2</field>
            <field name="color">2</field>
        </record>

        <record id="mail_bot_tag_urgent" model="mail.bot.tag">
            <field name="name">Urgent</field>
            <field name="sequence">3</field>
            <field name="color">3</field>
        </record>

        <!-- Sample Labels -->
        <record id="mail_bot_label_important" model="mail.bot.label">
            <field name="name">Important</field>
            <field name="sequence">1</field>
            <field name="label_color">#dc3545</field>
            <field name="text_color">#FFFFFF</field>
        </record>

        <record id="mail_bot_label_follow_up" model="mail.bot.label">
            <field name="name">Follow Up</field>
            <field name="sequence">2</field>
            <field name="label_color">#ffc107</field>
            <field name="text_color">#000000</field>
        </record>

        <record id="mail_bot_label_later" model="mail.bot.label">
            <field name="name">Later</field>
            <field name="sequence">3</field>
            <field name="label_color">#17a2b8</field>
            <field name="text_color">#FFFFFF</field>
        </record>

        <!-- Sample Folders -->
        <record id="mail_bot_folder_projects" model="mail.bot.folder">
            <field name="name">Projects</field>
            <field name="sequence">1</field>
            <field name="folder_type">custom</field>
            <field name="icon">fa-folder</field>
            <field name="color">4</field>
        </record>

        <record id="mail_bot_folder_clients" model="mail.bot.folder">
            <field name="name">Clients</field>
            <field name="sequence">2</field>
            <field name="folder_type">custom</field>
            <field name="icon">fa-users</field>
            <field name="color">5</field>
        </record>

        <!-- Sample Theme -->
        <record id="mail_bot_theme_default" model="mail.bot.theme">
            <field name="name">Default Purple</field>
            <field name="sequence">1</field>
            <field name="is_default">True</field>
            <field name="primary_color">#7c3aed</field>
            <field name="secondary_color">#d6397b</field>
            <field name="sidebar_color">#7c3aed</field>
            <field name="background_color">#f8f9fa</field>
            <field name="font_family">default</field>
        </record>

        <record id="mail_bot_theme_dark" model="mail.bot.theme">
            <field name="name">Dark Mode</field>
            <field name="sequence">2</field>
            <field name="is_default">False</field>
            <field name="primary_color">#1a1a2e</field>
            <field name="secondary_color">#16213e</field>
            <field name="sidebar_color">#0f3460</field>
            <field name="background_color">#1a1a2e</field>
            <field name="font_family">roboto</field>
        </record>

        <!-- Sample Inbox Messages -->
        <record id="mail_bot_inbox_sample_1" model="mail.bot.inbox">
            <field name="subject">Welcome to Mail Bot Management</field>
            <field name="sender_name">Mail Bot System</field>
            <field name="sender_email">system@mailbot.local</field>
            <field name="recipient_email">user@example.com</field>
            <field name="body"><![CDATA[
                <div style="font-family: Arial, sans-serif;">
                    <h2>Welcome to Mail Bot Management!</h2>
                    <p>Thank you for using Mail Bot Management. This is your sample inbox message.</p>
                    <p>You can:</p>
                    <ul>
                        <li>Compose new emails</li>
                        <li>Reply to messages</li>
                        <li>Organize with folders and labels</li>
                        <li>Use bot commands to automate tasks</li>
                    </ul>
                    <p>Best regards,<br/>The Mail Bot Team</p>
                </div>
            ]]></field>
            <field name="state">unread</field>
            <field name="priority">0</field>
            <field name="is_starred">True</field>
        </record>

        <record id="mail_bot_inbox_sample_2" model="mail.bot.inbox">
            <field name="subject">Meeting Request - Project Discussion</field>
            <field name="sender_name">John Smith</field>
            <field name="sender_email">john.smith@example.com</field>
            <field name="recipient_email">user@example.com</field>
            <field name="body"><![CDATA[
                <div style="font-family: Arial, sans-serif;">
                    <p>Hi,</p>
                    <p>I would like to schedule a meeting to discuss our upcoming project.</p>
                    <p>Please let me know your availability for next week.</p>
                    <p>Thanks,<br/>John</p>
                </div>
            ]]></field>
            <field name="state">unread</field>
            <field name="priority">1</field>
        </record>

        <record id="mail_bot_inbox_sample_3" model="mail.bot.inbox">
            <field name="subject">Invoice #2024-001 - Payment Reminder</field>
            <field name="sender_name">Billing Department</field>
            <field name="sender_email">billing@example.com</field>
            <field name="recipient_email">user@example.com</field>
            <field name="body"><![CDATA[
                <div style="font-family: Arial, sans-serif;">
                    <p>Dear Customer,</p>
                    <p>This is a friendly reminder that Invoice #2024-001 is due for payment.</p>
                    <p>Amount: $1,500.00</p>
                    <p>Due Date: January 15, 2026</p>
                    <p>Please process the payment at your earliest convenience.</p>
                    <p>Thank you,<br/>Billing Department</p>
                </div>
            ]]></field>
            <field name="state">read</field>
            <field name="priority">2</field>
            <field name="is_important">True</field>
        </record>

        <!-- Sample Sent Messages -->
        <record id="mail_bot_sent_sample_1" model="mail.bot.sent">
            <field name="subject">Re: Project Proposal</field>
            <field name="recipient_name">Jane Doe</field>
            <field name="recipient_email">jane.doe@example.com</field>
            <field name="body"><![CDATA[
                <div style="font-family: Arial, sans-serif;">
                    <p>Hi Jane,</p>
                    <p>Thank you for sending the project proposal. I have reviewed it and I'm pleased to say that it looks great!</p>
                    <p>Let's schedule a call to discuss the next steps.</p>
                    <p>Best regards</p>
                </div>
            ]]></field>
            <field name="state">sent</field>
        </record>

        <record id="mail_bot_sent_sample_2" model="mail.bot.sent">
            <field name="subject">Weekly Report - Week 2</field>
            <field name="recipient_name">Manager</field>
            <field name="recipient_email">manager@example.com</field>
            <field name="cc_emails">team@example.com</field>
            <field name="body"><![CDATA[
                <div style="font-family: Arial, sans-serif;">
                    <p>Hi Team,</p>
                    <p>Please find below the weekly report:</p>
                    <ul>
                        <li>Completed 5 tasks</li>
                        <li>Resolved 3 bugs</li>
                        <li>Started new feature development</li>
                    </ul>
                    <p>Best regards</p>
                </div>
            ]]></field>
            <field name="state">delivered</field>
        </record>

        <!-- Sample Draft Messages -->
        <record id="mail_bot_draft_sample_1" model="mail.bot.draft">
            <field name="subject">Follow-up: Partnership Discussion</field>
            <field name="recipient_email">partner@example.com</field>
            <field name="body"><![CDATA[
                <div style="font-family: Arial, sans-serif;">
                    <p>Hi,</p>
                    <p>Following up on our previous discussion about the partnership...</p>
                    <p>[Draft - To be completed]</p>
                </div>
            ]]></field>
        </record>

        <record id="mail_bot_draft_sample_2" model="mail.bot.draft">
            <field name="subject">Proposal for New Project</field>
            <field name="recipient_email">client@example.com</field>
            <field name="body"><![CDATA[
                <div style="font-family: Arial, sans-serif;">
                    <p>Dear Client,</p>
                    <p>I am writing to propose a new project that will...</p>
                    <p>[Draft - Needs more details]</p>
                </div>
            ]]></field>
        </record>

        <!-- Sample Spam Messages -->
        <record id="mail_bot_spam_sample_1" model="mail.bot.spam">
            <field name="subject">You've Won $1,000,000!!!</field>
            <field name="sender_name">Prize Department</field>
            <field name="sender_email">spam@suspicious-domain.com</field>
            <field name="recipient_email">user@example.com</field>
            <field name="body"><![CDATA[
                <div style="font-family: Arial, sans-serif;">
                    <p>CONGRATULATIONS! You have won $1,000,000!</p>
                    <p>Click here to claim your prize...</p>
                </div>
            ]]></field>
            <field name="spam_score">9.5</field>
            <field name="spam_reason">Suspicious keywords, unknown sender</field>
        </record>

        <!-- Sample Trash Messages -->
        <record id="mail_bot_trash_sample_1" model="mail.bot.trash">
            <field name="subject">Old Newsletter - December 2025</field>
            <field name="sender_name">Newsletter</field>
            <field name="sender_email">newsletter@example.com</field>
            <field name="recipient_email">user@example.com</field>
            <field name="body"><![CDATA[
                <div style="font-family: Arial, sans-serif;">
                    <p>December 2025 Newsletter content...</p>
                </div>
            ]]></field>
            <field name="original_folder">inbox</field>
        </record>

        <!-- Sample Lead Tags -->
        <record id="mail_bot_lead_tag_hot" model="mail.bot.lead.tag">
            <field name="name">Hot Lead</field>
            <field name="color">1</field>
        </record>

        <record id="mail_bot_lead_tag_cold" model="mail.bot.lead.tag">
            <field name="name">Cold Lead</field>
            <field name="color">4</field>
        </record>

        <!-- Sample Leads -->
        <record id="mail_bot_lead_sample_1" model="mail.bot.lead">
            <field name="name">Website Redesign Project</field>
            <field name="contact_name">Michael Johnson</field>
            <field name="email">michael.johnson@acme.com</field>
            <field name="phone">+1 555-1234</field>
            <field name="company_name">Acme Corporation</field>
            <field name="description"><![CDATA[
                <p>Potential project for complete website redesign.</p>
                <p>Budget: $15,000 - $25,000</p>
                <p>Timeline: Q2 2026</p>
            ]]></field>
            <field name="type">opportunity</field>
            <field name="stage">proposition</field>
            <field name="priority">2</field>
            <field name="expected_revenue">20000.00</field>
            <field name="probability">75.0</field>
        </record>

        <record id="mail_bot_lead_sample_2" model="mail.bot.lead">
            <field name="name">Mobile App Development Inquiry</field>
            <field name="contact_name">Sarah Williams</field>
            <field name="email">sarah.w@startup.io</field>
            <field name="phone">+1 555-5678</field>
            <field name="company_name">TechStartup Inc</field>
            <field name="description"><![CDATA[
                <p>Interested in developing a mobile app for iOS and Android.</p>
                <p>Features: User authentication, payment integration, push notifications</p>
            ]]></field>
            <field name="type">lead</field>
            <field name="stage">new</field>
            <field name="priority">1</field>
        </record>

        <!-- Sample Task Tags -->
        <record id="mail_bot_task_tag_dev" model="mail.bot.task.tag">
            <field name="name">Development</field>
            <field name="color">2</field>
        </record>

        <record id="mail_bot_task_tag_design" model="mail.bot.task.tag">
            <field name="name">Design</field>
            <field name="color">5</field>
        </record>

        <record id="mail_bot_task_tag_review" model="mail.bot.task.tag">
            <field name="name">Review</field>
            <field name="color">3</field>
        </record>

        <!-- Sample Tasks -->
        <record id="mail_bot_task_sample_1" model="mail.bot.task">
            <field name="name">Review project proposal document</field>
            <field name="description"><![CDATA[
                <p>Review the project proposal and provide feedback.</p>
                <ul>
                    <li>Check requirements</li>
                    <li>Verify timeline</li>
                    <li>Approve budget</li>
                </ul>
            ]]></field>
            <field name="priority">2</field>
            <field name="state">open</field>
            <field name="planned_hours">2.0</field>
        </record>

        <record id="mail_bot_task_sample_2" model="mail.bot.task">
            <field name="name">Prepare weekly status report</field>
            <field name="description"><![CDATA[
                <p>Compile weekly status report including:</p>
                <ul>
                    <li>Completed tasks</li>
                    <li>Pending items</li>
                    <li>Blockers</li>
                </ul>
            ]]></field>
            <field name="priority">1</field>
            <field name="state">draft</field>
            <field name="planned_hours">1.5</field>
        </record>

        <record id="mail_bot_task_sample_3" model="mail.bot.task">
            <field name="name">Update client documentation</field>
            <field name="description"><![CDATA[
                <p>Update the client-facing documentation with latest features and changes.</p>
            ]]></field>
            <field name="priority">0</field>
            <field name="state">done</field>
            <field name="planned_hours">3.0</field>
            <field name="effective_hours">2.5</field>
        </record>

    </data>
</odoo>
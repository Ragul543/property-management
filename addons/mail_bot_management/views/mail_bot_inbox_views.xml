<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mail_bot_inbox_tree" model="ir.ui.view">
        <field name="name">mail.bot.inbox.tree</field>
        <field name="model">mail.bot.inbox</field>
        <field name="arch" type="xml">
            <tree string="Inbox" decoration-bf="state == 'unread'" decoration-info="is_starred">
                <field name="is_starred" widget="boolean_favorite" nolabel="1"/>
                <field name="state" invisible="1"/>
                <field name="sender_name"/>
                <field name="subject"/>
                <field name="received_date"/>
                <field name="priority" widget="priority"/>
                <field name="has_attachments" widget="boolean"/>
                <field name="state" widget="badge" decoration-success="state == 'read'" decoration-info="state == 'unread'"/>
            </tree>
        </field>
    </record>

    <!-- Inbox Form View -->
    <record id="view_mail_bot_inbox_form" model="ir.ui.view">
        <field name="name">mail.bot.inbox.form</field>
        <field name="model">mail.bot.inbox</field>
        <field name="arch" type="xml">
            <form string="Inbox Message">
                <header>
                    <button name="action_reply" string="Reply" type="object" class="oe_highlight"/>
                    <button name="action_mark_as_read" string="Mark as Read" type="object" invisible="state in ('read', 'archived')"/>
                    <button name="action_mark_as_unread" string="Mark as Unread" type="object" invisible="state in ('unread', 'archived')"/>
                    <button name="action_unarchive" string="Move to Inbox" type="object" class="btn-primary" invisible="state != 'archived'"/>
                    <button name="action_archive" string="Archive" type="object" invisible="state == 'archived'"/>
                    <button name="action_mark_as_spam" string="Report Spam" type="object" class="btn-danger"/>
                    <button name="action_move_to_trash" string="Delete" type="object"/>
                    <field name="state" widget="statusbar" statusbar_visible="unread,read,archived"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_toggle_star" type="object" class="oe_stat_button" icon="fa-star">
                            <field name="is_starred" widget="boolean"/>
                        </button>
                        <button name="%(base.action_attachment)d" type="action" class="oe_stat_button" icon="fa-paperclip" context="{'default_res_model': 'mail.bot.inbox', 'default_res_id': id}">
                            <field name="attachment_count" widget="statinfo" string="Attachments"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="sender_name"/>
                            <field name="sender_email" widget="email"/>
                            <field name="recipient_email" widget="email"/>
                            <field name="cc_emails"/>
                            <field name="bcc_emails"/>
                        </group>
                        <group>
                            <field name="subject"/>
                            <field name="received_date"/>
                            <field name="priority" widget="priority"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Content">
                            <field name="body" widget="html"/>
                        </page>
                        <page string="Attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Technical Info">
                            <group>
                                <field name="message_id"/>
                                <field name="in_reply_to"/>
                                <field name="references"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Inbox Search View -->
    <record id="view_mail_bot_inbox_search" model="ir.ui.view">
        <field name="name">mail.bot.inbox.search</field>
        <field name="model">mail.bot.inbox</field>
        <field name="arch" type="xml">
            <search string="Search Inbox">
                <field name="subject"/>
                <field name="sender_name"/>
                <field name="sender_email"/>
                <filter string="Unread" name="unread" domain="[('state', '=', 'unread')]"/>
                <filter string="Starred" name="starred" domain="[('is_starred', '=', True)]"/>
                <filter string="With Attachments" name="has_attachments" domain="[('has_attachments', '=', True)]"/>
                <separator/>
                <filter string="Today" name="today" domain="[('received_date', '&gt;=', datetime.datetime.now().strftime('%Y-%m-%d'))]"/>
                <filter string="This Week" name="this_week" domain="[('received_date', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Sender" name="group_sender" context="{'group_by': 'sender_name'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Priority" name="group_priority" context="{'group_by': 'priority'}"/>
                    <filter string="Received Date" name="group_date" context="{'group_by': 'received_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Inbox Action -->
    <record id="action_mail_bot_inbox" model="ir.actions.act_window">
        <field name="name">Inbox</field>
        <field name="res_model">mail.bot.inbox</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_unread': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No messages in your inbox
            </p>
            <p>Your inbox is empty! All caught up.</p>
        </field>
    </record>

    <!-- Starred Action -->
    <record id="action_mail_bot_starred" model="ir.actions.act_window">
        <field name="name">Starred</field>
        <field name="res_model">mail.bot.inbox</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('is_starred', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No starred messages
            </p>
            <p>Star important messages to find them here.</p>
        </field>
    </record>

    <!-- Snoozed Action -->
    <record id="action_mail_bot_snoozed" model="ir.actions.act_window">
        <field name="name">Snoozed</field>
        <field name="res_model">mail.bot.inbox</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('state', '=', 'snoozed')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No snoozed messages
            </p>
            <p>Snoozed messages will appear here.</p>
        </field>
    </record>

    <!-- Done Action -->
    <record id="action_mail_bot_done" model="ir.actions.act_window">
        <field name="name">Done</field>
        <field name="res_model">mail.bot.inbox</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('state', '=', 'archived')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No done messages
            </p>
            <p>Messages marked as done will appear here.</p>
        </field>
    </record>

    <!-- All Messages Action -->
    <record id="action_mail_bot_all_messages" model="ir.actions.act_window">
        <field name="name">All Messages</field>
        <field name="res_model">mail.bot.inbox</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No messages
            </p>
            <p>All your messages will appear here.</p>
        </field>
    </record>

</odoo>
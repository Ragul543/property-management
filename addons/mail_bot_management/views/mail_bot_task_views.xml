<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Task Tree View -->
        <record id="mail_bot_task_view_tree" model="ir.ui.view">
            <field name="name">mail.bot.task.view.tree</field>
            <field name="model">mail.bot.task</field>
            <field name="arch" type="xml">
                <tree string="Tasks" decoration-info="state == 'draft'" decoration-success="state == 'done'" decoration-muted="state == 'cancelled'">
                    <field name="name"/>
                    <field name="user_id"/>
                    <field name="priority"/>
                    <field name="state"/>
                    <field name="date_deadline"/>
                    <field name="planned_hours"/>
                    <field name="effective_hours"/>
                </tree>
            </field>
        </record>

        <!-- Task Kanban View -->
        <record id="mail_bot_task_view_kanban" model="ir.ui.view">
            <field name="name">mail.bot.task.view.kanban</field>
            <field name="model">mail.bot.task</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" class="o_kanban_small_column">
                    <field name="name"/>
                    <field name="user_id"/>
                    <field name="state"/>
                    <field name="color"/>
                    <field name="priority"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_color_#{kanban_getcolor(record.color.raw_value)} oe_kanban_card oe_kanban_global_click">
                                <div class="oe_kanban_content">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <field name="name"/>
                                            </strong>
                                        </div>
                                        <field name="priority" widget="priority"/>
                                    </div>
                                    <div class="o_kanban_record_body">
                                        <t t-if="record.date_deadline.raw_value">
                                            <span class="text-muted">Deadline: </span>
                                            <field name="date_deadline"/>
                                        </t>
                                    </div>
                                    <div class="o_kanban_record_bottom">
                                        <div class="oe_kanban_bottom_left">
                                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                        </div>
                                        <div class="oe_kanban_bottom_right">
                                            <field name="user_id" widget="many2one_avatar_user"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Task Form View -->
        <record id="mail_bot_task_view_form" model="ir.ui.view">
            <field name="name">mail.bot.task.view.form</field>
            <field name="model">mail.bot.task</field>
            <field name="arch" type="xml">
                <form string="Task">
                    <header>
                        <button name="action_start" type="object"
                                string="Start" class="btn-primary"
                                invisible="state not in ['draft', 'pending']"/>
                        <button name="action_done" type="object"
                                string="Mark Done" class="btn-success"
                                invisible="state in ['done', 'cancelled']"/>
                        <button name="action_reopen" type="object"
                                string="Reopen"
                                invisible="state not in ['done', 'cancelled']"/>
                        <button name="action_cancel" type="object"
                                string="Cancel"
                                invisible="state in ['done', 'cancelled']"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,open,done"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" placeholder="Task Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="user_id"/>
                                <field name="priority" widget="priority"/>
                                <field name="partner_id"/>
                                <field name="lead_id"/>
                            </group>
                            <group>
                                <field name="date_deadline"/>
                                <field name="date_start"/>
                                <field name="date_end"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Description" name="description">
                                <field name="description"/>
                            </page>
                            <page string="Time Tracking" name="time">
                                <group>
                                    <group>
                                        <field name="planned_hours" widget="float_time"/>
                                    </group>
                                    <group>
                                        <field name="effective_hours" widget="float_time"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Tags" name="tags">
                                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            </page>
                            <page string="Other Info" name="other">
                                <group>
                                    <group>
                                        <field name="source_email_id"/>
                                    </group>
                                    <group>
                                        <field name="company_id" groups="base.group_multi_company"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Task Search View -->
        <record id="mail_bot_task_view_search" model="ir.ui.view">
            <field name="name">mail.bot.task.view.search</field>
            <field name="model">mail.bot.task</field>
            <field name="arch" type="xml">
                <search string="Search Tasks">
                    <field name="name"/>
                    <field name="user_id"/>
                    <filter name="my_tasks" string="My Tasks" domain="[('user_id', '=', uid)]"/>
                    <separator/>
                    <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                    <filter name="in_progress" string="In Progress" domain="[('state', '=', 'open')]"/>
                    <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                    <separator/>
                    <filter name="urgent" string="Urgent" domain="[('priority', '=', '3')]"/>
                    <filter name="overdue" string="Overdue" domain="[('date_deadline', '&lt;', context_today().strftime('%Y-%m-%d')), ('state', 'not in', ['done', 'cancelled'])]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                        <filter name="group_user" string="Assigned To" context="{'group_by': 'user_id'}"/>
                        <filter name="group_priority" string="Priority" context="{'group_by': 'priority'}"/>
                        <filter name="group_deadline" string="Deadline" context="{'group_by': 'date_deadline:month'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Task Action -->
        <record id="mail_bot_task_action" model="ir.actions.act_window">
            <field name="name">Tasks</field>
            <field name="res_model">mail.bot.task</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="context">{'search_default_my_tasks': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No tasks yet
                </p>
                <p>
                    Tasks can be created manually or automatically via email bot commands.
                    Send an email with "Create Task" to your bot address to create a new task.
                </p>
            </field>
        </record>

        <!-- Task Tag Tree View -->
        <record id="mail_bot_task_tag_view_tree" model="ir.ui.view">
            <field name="name">mail.bot.task.tag.view.tree</field>
            <field name="model">mail.bot.task.tag</field>
            <field name="arch" type="xml">
                <tree string="Task Tags" editable="bottom">
                    <field name="name"/>
                    <field name="color" widget="color_picker"/>
                </tree>
            </field>
        </record>

        <!-- Task Tag Action -->
        <record id="mail_bot_task_tag_action" model="ir.actions.act_window">
            <field name="name">Task Tags</field>
            <field name="res_model">mail.bot.task.tag</field>
            <field name="view_mode">tree</field>
        </record>

    </data>
</odoo>

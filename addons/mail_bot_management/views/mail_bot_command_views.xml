<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Bot Command Tree View -->
        <record id="mail_bot_command_view_tree" model="ir.ui.view">
            <field name="name">mail.bot.command.view.tree</field>
            <field name="model">mail.bot.command</field>
            <field name="arch" type="xml">
                <tree string="Bot Commands">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="target_model"/>
                    <field name="keywords"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <!-- Bot Command Form View -->
        <record id="mail_bot_command_view_form" model="ir.ui.view">
            <field name="name">mail.bot.command.view.form</field>
            <field name="model">mail.bot.command</field>
            <field name="arch" type="xml">
                <form string="Bot Command">
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Command Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="target_model"/>
                                <field name="sequence"/>
                            </group>
                            <group>
                                <field name="active"/>
                            </group>
                        </group>
                        <group string="Keywords">
                            <field name="keywords" nolabel="1" placeholder="create lead, new lead, add lead"/>
                            <p class="text-muted">
                                Enter comma-separated keywords that will trigger this command.
                                The bot will check if any of these keywords appear in the email content.
                            </p>
                        </group>
                        <notebook>
                            <page string="Response Templates" name="templates">
                                <group>
                                    <field name="success_template"/>
                                    <field name="error_template"/>
                                </group>
                            </page>
                            <page string="Help" name="help">
                                <group>
                                    <field name="description" placeholder="Description shown to users in help messages"/>
                                </group>
                            </page>
                            <page string="Other Info" name="other">
                                <group>
                                    <group>
                                        <field name="user_id"/>
                                        <field name="company_id" groups="base.group_multi_company"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Bot Command Search View -->
        <record id="mail_bot_command_view_search" model="ir.ui.view">
            <field name="name">mail.bot.command.view.search</field>
            <field name="model">mail.bot.command</field>
            <field name="arch" type="xml">
                <search string="Search Commands">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="keywords"/>
                    <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                    <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_model" string="Target Model" context="{'group_by': 'target_model'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Bot Command Action -->
        <record id="mail_bot_command_action" model="ir.actions.act_window">
            <field name="name">Bot Commands</field>
            <field name="res_model">mail.bot.command</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Define your first bot command
                </p>
                <p>
                    Bot commands define how the email bot interprets and responds to incoming emails.
                    Each command has keywords that trigger it and a target model where records are created.
                </p>
            </field>
        </record>

    </data>
</odoo>

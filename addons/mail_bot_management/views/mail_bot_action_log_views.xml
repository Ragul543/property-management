<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Action Log Tree View -->
        <record id="mail_bot_action_log_view_tree" model="ir.ui.view">
            <field name="name">mail.bot.action.log.view.tree</field>
            <field name="model">mail.bot.action.log</field>
            <field name="arch" type="xml">
                <tree string="Bot Action Logs" decoration-success="state == 'success'" decoration-danger="state == 'failed'">
                    <field name="processed_date"/>
                    <field name="bot_address_id"/>
                    <field name="sender_email"/>
                    <field name="action_type"/>
                    <field name="command_id"/>
                    <field name="state"/>
                    <field name="res_model"/>
                    <field name="res_id"/>
                </tree>
            </field>
        </record>

        <!-- Action Log Form View -->
        <record id="mail_bot_action_log_view_form" model="ir.ui.view">
            <field name="name">mail.bot.action.log.view.form</field>
            <field name="model">mail.bot.action.log</field>
            <field name="arch" type="xml">
                <form string="Bot Action Log" create="false" edit="false">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_created_record" type="object"
                                    class="oe_stat_button" icon="fa-external-link"
                                    invisible="not res_id">
                                <span>View Record</span>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="processed_date"/>
                                <field name="bot_address_id"/>
                                <field name="command_id"/>
                                <field name="action_type"/>
                                <field name="state"/>
                            </group>
                            <group>
                                <field name="sender_name"/>
                                <field name="sender_email"/>
                                <field name="res_model"/>
                                <field name="res_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Details" name="details">
                                <group>
                                    <field name="raw_command"/>
                                    <field name="parsed_data"/>
                                    <field name="error_message" invisible="state != 'failed'"/>
                                </group>
                            </page>
                            <page string="Response" name="response">
                                <group>
                                    <field name="response_sent"/>
                                    <field name="response_email_id"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action Log Search View -->
        <record id="mail_bot_action_log_view_search" model="ir.ui.view">
            <field name="name">mail.bot.action.log.view.search</field>
            <field name="model">mail.bot.action.log</field>
            <field name="arch" type="xml">
                <search string="Search Action Logs">
                    <field name="sender_email"/>
                    <field name="bot_address_id"/>
                    <field name="command_id"/>
                    <filter name="success" string="Success" domain="[('state', '=', 'success')]"/>
                    <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                    <separator/>
                    <filter name="today" string="Today" domain="[('processed_date', '>=', context_today().strftime('%Y-%m-%d'))]"/>
                    <filter name="this_week" string="This Week" domain="[('processed_date', '>=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_bot" string="Bot Address" context="{'group_by': 'bot_address_id'}"/>
                        <filter name="group_action" string="Action Type" context="{'group_by': 'action_type'}"/>
                        <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                        <filter name="group_date" string="Date" context="{'group_by': 'processed_date:day'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action Log Action -->
        <record id="mail_bot_action_log_action" model="ir.actions.act_window">
            <field name="name">Bot Action Logs</field>
            <field name="res_model">mail.bot.action.log</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_today': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No action logs yet
                </p>
                <p>
                    Action logs track all commands processed by email bots.
                    Send an email to a bot address to see logs appear here.
                </p>
            </field>
        </record>

    </data>
</odoo>

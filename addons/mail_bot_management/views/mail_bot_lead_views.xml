<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Lead Tree View -->
        <record id="mail_bot_lead_view_tree" model="ir.ui.view">
            <field name="name">mail.bot.lead.view.tree</field>
            <field name="model">mail.bot.lead</field>
            <field name="arch" type="xml">
                <tree string="Leads" decoration-info="stage == 'new'" decoration-success="stage == 'won'" decoration-muted="stage == 'lost'">
                    <field name="name"/>
                    <field name="contact_name"/>
                    <field name="email"/>
                    <field name="phone"/>
                    <field name="company_name"/>
                    <field name="type"/>
                    <field name="stage"/>
                    <field name="user_id"/>
                    <field name="create_date"/>
                </tree>
            </field>
        </record>

        <!-- Lead Kanban View -->
        <record id="mail_bot_lead_view_kanban" model="ir.ui.view">
            <field name="name">mail.bot.lead.view.kanban</field>
            <field name="model">mail.bot.lead</field>
            <field name="arch" type="xml">
                <kanban default_group_by="stage" class="o_kanban_small_column">
                    <field name="name"/>
                    <field name="contact_name"/>
                    <field name="email"/>
                    <field name="phone"/>
                    <field name="stage"/>
                    <field name="color"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_color_#{kanban_getcolor(record.color.raw_value)} oe_kanban_card oe_kanban_global_click">
                                <div class="oe_kanban_content">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <field name="name"/>
                                            </strong>
                                        </div>
                                        <field name="priority" widget="priority"/>
                                    </div>
                                    <div class="o_kanban_record_body">
                                        <field name="contact_name"/>
                                        <br/>
                                        <field name="email"/>
                                    </div>
                                    <div class="o_kanban_record_bottom">
                                        <div class="oe_kanban_bottom_left">
                                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                        </div>
                                        <div class="oe_kanban_bottom_right">
                                            <field name="user_id" widget="many2one_avatar_user"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Lead Form View -->
        <record id="mail_bot_lead_view_form" model="ir.ui.view">
            <field name="name">mail.bot.lead.view.form</field>
            <field name="model">mail.bot.lead</field>
            <field name="arch" type="xml">
                <form string="Lead">
                    <header>
                        <button name="action_convert_to_opportunity" type="object"
                                string="Convert to Opportunity" class="btn-primary"
                                invisible="type == 'opportunity'"/>
                        <button name="action_mark_won" type="object"
                                string="Mark Won" class="btn-success"
                                invisible="stage == 'won'"/>
                        <button name="action_mark_lost" type="object"
                                string="Mark Lost"
                                invisible="stage == 'lost'"/>
                        <field name="stage" widget="statusbar" statusbar_visible="new,qualified,proposition,won"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" placeholder="Lead Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="type"/>
                                <field name="priority" widget="priority"/>
                                <field name="user_id"/>
                                <field name="partner_id"/>
                            </group>
                            <group>
                                <field name="expected_revenue"/>
                                <field name="probability"/>
                                <field name="date_deadline"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Contact Information" name="contact">
                                <group>
                                    <group>
                                        <field name="contact_name"/>
                                        <field name="email"/>
                                        <field name="phone"/>
                                        <field name="mobile"/>
                                    </group>
                                    <group>
                                        <field name="company_name"/>
                                        <field name="website"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Description" name="description">
                                <field name="description"/>
                            </page>
                            <page string="Tags" name="tags">
                                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            </page>
                            <page string="Other Info" name="other">
                                <group>
                                    <group>
                                        <field name="source"/>
                                        <field name="source_email_id"/>
                                    </group>
                                    <group>
                                        <field name="date_conversion" invisible="type != 'opportunity'"/>
                                        <field name="company_id" groups="base.group_multi_company"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Lead Search View -->
        <record id="mail_bot_lead_view_search" model="ir.ui.view">
            <field name="name">mail.bot.lead.view.search</field>
            <field name="model">mail.bot.lead</field>
            <field name="arch" type="xml">
                <search string="Search Leads">
                    <field name="name"/>
                    <field name="contact_name"/>
                    <field name="email"/>
                    <field name="phone"/>
                    <field name="company_name"/>
                    <filter name="my_leads" string="My Leads" domain="[('user_id', '=', uid)]"/>
                    <separator/>
                    <filter name="leads" string="Leads" domain="[('type', '=', 'lead')]"/>
                    <filter name="opportunities" string="Opportunities" domain="[('type', '=', 'opportunity')]"/>
                    <separator/>
                    <filter name="new" string="New" domain="[('stage', '=', 'new')]"/>
                    <filter name="won" string="Won" domain="[('stage', '=', 'won')]"/>
                    <filter name="lost" string="Lost" domain="[('stage', '=', 'lost')]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_stage" string="Stage" context="{'group_by': 'stage'}"/>
                        <filter name="group_type" string="Type" context="{'group_by': 'type'}"/>
                        <filter name="group_user" string="Salesperson" context="{'group_by': 'user_id'}"/>
                        <filter name="group_date" string="Creation Date" context="{'group_by': 'create_date:month'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Lead Action -->
        <record id="mail_bot_lead_action" model="ir.actions.act_window">
            <field name="name">Leads</field>
            <field name="res_model">mail.bot.lead</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="context">{'search_default_my_leads': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No leads yet
                </p>
                <p>
                    Leads can be created manually or automatically via email bot commands.
                    Send an email with "Create Lead" to your bot address to create a new lead.
                </p>
            </field>
        </record>

        <!-- Lead Tag Tree View -->
        <record id="mail_bot_lead_tag_view_tree" model="ir.ui.view">
            <field name="name">mail.bot.lead.tag.view.tree</field>
            <field name="model">mail.bot.lead.tag</field>
            <field name="arch" type="xml">
                <tree string="Lead Tags" editable="bottom">
                    <field name="name"/>
                    <field name="color" widget="color_picker"/>
                </tree>
            </field>
        </record>

        <!-- Lead Tag Action -->
        <record id="mail_bot_lead_tag_action" model="ir.actions.act_window">
            <field name="name">Lead Tags</field>
            <field name="res_model">mail.bot.lead.tag</field>
            <field name="view_mode">tree</field>
        </record>

    </data>
</odoo>

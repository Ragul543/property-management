<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Category for Mail Bot (must be defined before groups that reference it) -->
        <record id="module_category_mail_bot" model="ir.module.category">
            <field name="name">Mail Bot Management</field>
            <field name="description">Mail Bot Management System</field>
            <field name="sequence">10</field>
        </record>

        <!-- Security Groups -->
        <record id="group_mail_bot_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="mail_bot_management.module_category_mail_bot"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_mail_bot_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="mail_bot_management.module_category_mail_bot"/>
            <field name="implied_ids" eval="[(4, ref('group_mail_bot_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Record Rules for Inbox -->
        <record id="mail_bot_inbox_user_rule" model="ir.rule">
            <field name="name">Mail Bot Inbox: User - Own Messages</field>
            <field name="model_id" ref="model_mail_bot_inbox"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_mail_bot_user'))]"/>
        </record>

        <record id="mail_bot_inbox_manager_rule" model="ir.rule">
            <field name="name">Mail Bot Inbox: Manager - All Messages</field>
            <field name="model_id" ref="model_mail_bot_inbox"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_mail_bot_manager'))]"/>
        </record>

        <!-- Record Rules for Sent -->
        <record id="mail_bot_sent_user_rule" model="ir.rule">
            <field name="name">Mail Bot Sent: User - Own Messages</field>
            <field name="model_id" ref="model_mail_bot_sent"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_mail_bot_user'))]"/>
        </record>

        <record id="mail_bot_sent_manager_rule" model="ir.rule">
            <field name="name">Mail Bot Sent: Manager - All Messages</field>
            <field name="model_id" ref="model_mail_bot_sent"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_mail_bot_manager'))]"/>
        </record>

        <!-- Record Rules for Draft -->
        <record id="mail_bot_draft_user_rule" model="ir.rule">
            <field name="name">Mail Bot Draft: User - Own Drafts</field>
            <field name="model_id" ref="model_mail_bot_draft"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_mail_bot_user'))]"/>
        </record>

        <record id="mail_bot_draft_manager_rule" model="ir.rule">
            <field name="name">Mail Bot Draft: Manager - All Drafts</field>
            <field name="model_id" ref="model_mail_bot_draft"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_mail_bot_manager'))]"/>
        </record>

        <!-- Record Rules for Spam -->
        <record id="mail_bot_spam_user_rule" model="ir.rule">
            <field name="name">Mail Bot Spam: User - Own Spam</field>
            <field name="model_id" ref="model_mail_bot_spam"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_mail_bot_user'))]"/>
        </record>

        <record id="mail_bot_spam_manager_rule" model="ir.rule">
            <field name="name">Mail Bot Spam: Manager - All Spam</field>
            <field name="model_id" ref="model_mail_bot_spam"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_mail_bot_manager'))]"/>
        </record>

        <!-- Record Rules for Trash -->
        <record id="mail_bot_trash_user_rule" model="ir.rule">
            <field name="name">Mail Bot Trash: User - Own Trash</field>
            <field name="model_id" ref="model_mail_bot_trash"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_mail_bot_user'))]"/>
        </record>

        <record id="mail_bot_trash_manager_rule" model="ir.rule">
            <field name="name">Mail Bot Trash: Manager - All Trash</field>
            <field name="model_id" ref="model_mail_bot_trash"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_mail_bot_manager'))]"/>
        </record>

        <!-- Record Rules for Bot Address - Manager Only -->
        <record id="mail_bot_address_manager_rule" model="ir.rule">
            <field name="name">Mail Bot Address: Manager Only</field>
            <field name="model_id" ref="model_mail_bot_address"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_mail_bot_manager'))]"/>
        </record>

        <!-- Record Rules for Bot Command - Manager Only -->
        <record id="mail_bot_command_manager_rule" model="ir.rule">
            <field name="name">Mail Bot Command: Manager Full Access</field>
            <field name="model_id" ref="model_mail_bot_command"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_mail_bot_manager'))]"/>
        </record>

        <!-- Record Rules for Action Log -->
        <record id="mail_bot_action_log_user_rule" model="ir.rule">
            <field name="name">Mail Bot Action Log: User - Own Logs</field>
            <field name="model_id" ref="model_mail_bot_action_log"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_mail_bot_user'))]"/>
        </record>

        <record id="mail_bot_action_log_manager_rule" model="ir.rule">
            <field name="name">Mail Bot Action Log: Manager - All Logs</field>
            <field name="model_id" ref="model_mail_bot_action_log"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_mail_bot_manager'))]"/>
        </record>

        <!-- Record Rules for Lead -->
        <record id="mail_bot_lead_user_rule" model="ir.rule">
            <field name="name">Mail Bot Lead: User - Assigned Leads</field>
            <field name="model_id" ref="model_mail_bot_lead"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_mail_bot_user'))]"/>
        </record>

        <record id="mail_bot_lead_manager_rule" model="ir.rule">
            <field name="name">Mail Bot Lead: Manager - All Leads</field>
            <field name="model_id" ref="model_mail_bot_lead"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_mail_bot_manager'))]"/>
        </record>

        <!-- Record Rules for Task -->
        <record id="mail_bot_task_user_rule" model="ir.rule">
            <field name="name">Mail Bot Task: User - Assigned Tasks</field>
            <field name="model_id" ref="model_mail_bot_task"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_mail_bot_user'))]"/>
        </record>

        <record id="mail_bot_task_manager_rule" model="ir.rule">
            <field name="name">Mail Bot Task: Manager - All Tasks</field>
            <field name="model_id" ref="model_mail_bot_task"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_mail_bot_manager'))]"/>
        </record>

    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- WhatsApp Config Form View -->
    <record id="whatsapp_config_view_form" model="ir.ui.view">
        <field name="name">whatsapp.config.form</field>
        <field name="model">whatsapp.config</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Configuration">
                <header>
                    <button name="action_check_status" string="Check Status" type="object" class="oe_highlight"/>
                    <button name="action_get_qr" string="Get QR Code" type="object" invisible="state == 'connected'"/>
                    <button name="action_logout" string="Logout" type="object" class="btn-danger" invisible="state != 'connected'" confirm="Are you sure you want to logout from WhatsApp? You will need to scan QR code again to reconnect."/>
                    <field name="state" widget="statusbar" statusbar_visible="disconnected,connecting,connected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Configuration Name"/></h1>
                    </div>
                    <group>
                        <group string="Server Settings">
                            <field name="server_url" placeholder="http://localhost:3006"/>
                            <field name="api_key" password="True"/>
                            <field name="webhook_secret" password="True"/>
                        </group>
                        <group string="Options">
                            <field name="default_country_code"/>
                            <field name="active"/>
                            <field name="last_check"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Help" name="help">
                            <div class="alert alert-info" role="alert">
                                <h4>Setup Instructions:</h4>
                                <ol>
                                    <li>Enter your WhatsApp bot server URL</li>
                                    <li>Enter the API key from your .env file</li>
                                    <li>Click "Check Status" to verify connection</li>
                                    <li>If not connected, click "Get QR Code" and scan with WhatsApp</li>
                                    <li>To disconnect, click the "Logout" button (only visible when connected)</li>
                                </ol>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- WhatsApp Config List View -->
    <record id="whatsapp_config_view_list" model="ir.ui.view">
        <field name="name">whatsapp.config.list</field>
        <field name="model">whatsapp.config</field>
        <field name="arch" type="xml">
            <tree string="WhatsApp Configurations">
                <field name="name"/>
                <field name="server_url"/>
                <field name="state" decoration-success="state == 'connected'" decoration-warning="state == 'connecting'" decoration-danger="state == 'disconnected'" widget="badge"/>
                <field name="last_check"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Action -->
    <record id="whatsapp_config_action" model="ir.actions.act_window">
        <field name="name">WhatsApp Settings</field>
        <field name="res_model">whatsapp.config</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure your WhatsApp connection
            </p>
        </field>
    </record>
</odoo>

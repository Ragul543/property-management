<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- WhatsApp Message Form View -->
    <record id="whatsapp_message_view_form" model="ir.ui.view">
        <field name="name">whatsapp.message.form</field>
        <field name="model">whatsapp.message</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Message">
                <header>
                    <button name="action_retry_send" string="Retry Send" type="object"
                            invisible="state != 'failed' or direction != 'outgoing'"
                            class="oe_highlight"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="Message Info">
                            <field name="phone"/>
                            <field name="direction"/>
                            <field name="message_type"/>
                            <field name="partner_id"/>
                            <field name="employee_id"/>
                            <field name="timestamp"/>
                        </group>
                        <group string="Details">
                            <field name="message_id"/>
                            <field name="author"/>
                            <field name="has_media"/>
                        </group>
                    </group>
                    <group string="Message Content">
                        <field name="body" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Media" invisible="not has_media">
                        <field name="media_filename"/>
                        <field name="media_mimetype"/>
                        <field name="media_data" filename="media_filename"/>
                    </group>
                    <group string="Error" invisible="not error_message">
                        <field name="error_message" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- WhatsApp Message Tree View -->
    <record id="whatsapp_message_view_tree" model="ir.ui.view">
        <field name="name">whatsapp.message.list</field>
        <field name="model">whatsapp.message</field>
        <field name="arch" type="xml">
            <tree string="WhatsApp Messages" default_order="create_date desc">
                <field name="timestamp"/>
                <field name="direction" decoration-info="direction == 'incoming'" decoration-success="direction == 'outgoing'" widget="badge"/>
                <field name="phone"/>
                <field name="partner_id"/>
                <field name="employee_id"/>
                <field name="body"/>
                <field name="message_type"/>
                <field name="state" decoration-success="state in ('sent','delivered','read','received')" decoration-danger="state == 'failed'" decoration-warning="state == 'draft'" widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- Search View -->
    <record id="whatsapp_message_view_search" model="ir.ui.view">
        <field name="name">whatsapp.message.search</field>
        <field name="model">whatsapp.message</field>
        <field name="arch" type="xml">
            <search string="Search Messages">
                <field name="phone"/>
                <field name="body"/>
                <field name="partner_id"/>
                <field name="employee_id"/>
                <filter name="incoming" string="Incoming" domain="[('direction', '=', 'incoming')]"/>
                <filter name="outgoing" string="Outgoing" domain="[('direction', '=', 'outgoing')]"/>
                <separator/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <filter name="today" string="Today" domain="[('create_date', '>=', (context_today()).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_partner" string="Contact" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_direction" string="Direction" context="{'group_by': 'direction'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="whatsapp_message_action" model="ir.actions.act_window">
        <field name="name">WhatsApp Messages</field>
        <field name="res_model">whatsapp.message</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No messages yet
            </p>
            <p>WhatsApp messages will appear here when sent or received.</p>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend Employee Form View -->
    <record id="hr_employee_view_form_whatsapp" model="ir.ui.view">
        <field name="name">hr.employee.form.whatsapp</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <!-- Add WhatsApp button in header -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_whatsapp_messages" type="object"
                        class="oe_stat_button" icon="fa-whatsapp"
                        invisible="whatsapp_message_count == 0">
                    <field name="whatsapp_message_count" widget="statinfo" string="Messages"/>
                </button>
            </xpath>

            <!-- Add Send WhatsApp button after existing buttons -->
            <xpath expr="//div[@name='button_box']" position="after">
                <div class="oe_button_box" name="whatsapp_buttons">
                    <button name="action_send_whatsapp" string="Send WhatsApp" type="object"
                            class="btn-success" icon="fa-whatsapp"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- WhatsApp User Group -->
    <record id="group_whatsapp_user" model="res.groups">
        <field name="name">WhatsApp User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- WhatsApp Manager Group -->
    <record id="group_whatsapp_manager" model="res.groups">
        <field name="name">WhatsApp Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_whatsapp_user'))]"/>
    </record>

    <!-- Auto-grant groups to internal and system users -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_whatsapp_user'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_whatsapp_manager'))]"/>
    </record>

    <!-- Config Record Rule - Only managers can modify -->
    <record id="whatsapp_config_rule_manager" model="ir.rule">
        <field name="name">WhatsApp Config: Manager Full Access</field>
        <field name="model_id" ref="model_whatsapp_config"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_whatsapp_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Message Record Rule - Users can see all messages -->
    <record id="whatsapp_message_rule_user" model="ir.rule">
        <field name="name">WhatsApp Message: User Read Access</field>
        <field name="model_id" ref="model_whatsapp_message"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_whatsapp_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>

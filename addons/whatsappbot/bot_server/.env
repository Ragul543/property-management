# WhatsApp Bot Server Configuration

# Server port (matches your Odoo config: http://143.1.1.85:3006)
PORT=3002

# API Key for authentication (set same value in Odoo WhatsApp Settings)
API_KEY=whatsapp-api-key

# Odoo webhook URL (your Odoo server)
WEBHOOK_URL=http://143.1.1.65:8002/whatsapp/webhook

# Webhook secret for HMAC signature verification (optional)
WEBHOOK_SECRET=
